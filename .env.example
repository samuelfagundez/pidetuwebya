# Copia este archivo a ".env.local" (no se sube al repo) y completa los
# valores reales. La app funciona sin ellos, pero los formularios no podrán
# enviar el correo de aviso: sólo guardarán el lead en localStorage y lo
# avisarán por consola.

# Número de WhatsApp de contacto, en formato internacional y SIN "+"
# (el que exige wa.me). Ejemplo para España: 34600000000
VITE_WHATSAPP_NUMBER=

# Credenciales de EmailJS (https://www.emailjs.com) — envío de correo sin
# backend. Se crean en el dashboard de EmailJS:
#   1. Un "Service" (conectado a tu Gmail/Outlook/etc.) -> VITE_EMAILJS_SERVICE_ID
#   2. Un "Template" para el lead del Formulario 1 (nombre + contacto)
#      -> VITE_EMAILJS_TEMPLATE_LEAD
#   3. Un "Template" para la solicitud final del Formulario 2 (colores,
#      imágenes, secciones) -> VITE_EMAILJS_TEMPLATE_REQUEST
#   4. La "Public Key" de tu cuenta -> VITE_EMAILJS_PUBLIC_KEY
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TEMPLATE_LEAD=
VITE_EMAILJS_TEMPLATE_REQUEST=
